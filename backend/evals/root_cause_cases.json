{
  "suite_version": "1.0",
  "description": "Synthetic, answer-keyed business KPI incidents for controlled Root Cause Analytics evaluation.",
  "cases": [
    {
      "id": "RCA-001",
      "name": "Germany mobile payment failures",
      "severity": "critical",
      "scenario": "Revenue fell from 100000 to 90000. Checkout evidence isolates most of the loss to failed mobile payments in Germany.",
      "available_evidence_ids": ["E1", "E2", "E3"],
      "expected": {
        "is_anomaly": true,
        "incident_type": "business_incident",
        "primary_branches": ["conversion"],
        "affected_segments": [{"country": "Germany", "device": "mobile"}],
        "contributions": {"germany_mobile_payment_failures": -6000},
        "contribution_tolerance": 1,
        "hypotheses": {"payment_failure": "supported", "traffic_decline": "rejected"},
        "must_abstain": false,
        "reconciliation": {"total_movement": -10000, "explained_movement": -8000, "unexplained_movement": -2000, "tolerance": 1},
        "causal_evidence": false,
        "required_evidence_ids": ["E1", "E2", "E3"]
      }
    },
    {
      "id": "RCA-002",
