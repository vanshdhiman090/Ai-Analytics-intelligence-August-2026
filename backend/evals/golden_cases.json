    },
    {
      "id": "METHOD-001", "name": "Time questions require a time-based method", "category": "methodology", "severity": "critical",
      "question": "How did revenue change over time?", "rows": [{"date":"2026-01-01","revenue":10},{"date":"2026-02-01","revenue":20}],
      "plan": {"objective":"Describe revenue","question_coverage":["Revenue"],"operations":[{"operation_id":"OP1","kind":"distribution","metric_column":"revenue","rationale":"Describe values"}]},
      "expected_error": "no time-based operation", "assertions": []
    },
    {
