{
  "suite_version": "2.0",
  "description": "Deterministic release gate for calculations, methodology, safety, uncertainty, data handling, and reproducibility.",
  "cases": [
    {
      "id": "CALC-001", "name": "Regional sum ranking is exact", "category": "calculation", "severity": "critical",
      "rows": [{"region":"North","revenue":100},{"region":"South","revenue":70},{"region":"North","revenue":40}],
      "plan": {"objective":"Rank total revenue by region","question_coverage":["Regional ranking"],"operations":[{"operation_id":"OP1","kind":"grouped_aggregate","metric_column":"revenue","dimension_column":"region","aggregation":"sum","rationale":"Compare regions"}]},
      "assertions": [{"type":"equals","path":"results.0.rows.0.region","expected":"North"},{"type":"equals","path":"results.0.rows.0.value","expected":140},{"type":"equals","path":"results.0.rows.0.rank","expected":1}]
    },
    {
      "id": "CALC-002", "name": "Contribution shares reconcile to 100 percent", "category": "calculation", "severity": "critical",
      "rows": [{"segment":"A","sales":80},{"segment":"B","sales":15},{"segment":"C","sales":5}],
      "plan": {"objective":"Measure segment contribution","question_coverage":["Contribution"],"operations":[{"operation_id":"OP1","kind":"grouped_aggregate","metric_column":"sales","dimension_column":"segment","aggregation":"sum","rationale":"Calculate shares"}]},
      "assertions": [{"type":"sum_approx","path":"results.0.rows.*.share_of_total_pct","expected":100,"tolerance":0.000001},{"type":"approx","path":"results.0.diagnostics.top_group_share_pct","expected":80,"tolerance":0.000001}]
    },
    {
      "id": "CALC-003", "name": "Grouped means preserve group sample counts", "category": "calculation", "severity": "high",
      "rows": [{"team":"A","score":10},{"team":"A","score":20},{"team":"B","score":100}],
      "plan": {"objective":"Compare average score by team","question_coverage":["Team averages"],"operations":[{"operation_id":"OP1","kind":"grouped_aggregate","metric_column":"score","dimension_column":"team","aggregation":"mean","rationale":"Compare means"}]},
      "assertions": [{"type":"equals","path":"results.0.rows.0.team","expected":"B"},{"type":"equals","path":"results.0.rows.1.observed_count","expected":2},{"type":"is_null","path":"results.0.diagnostics.top_group_share_pct"}]
    },
    {
      "id": "CALC-004", "name": "Latest period change uses the immediately prior period", "category": "calculation", "severity": "critical",
      "rows": [{"date":"2026-01-01","sales":100},{"date":"2026-02-01","sales":125},{"date":"2026-03-01","sales":150}],
      "plan": {"objective":"Compare latest monthly sales with prior month","question_coverage":["Period change"],"operations":[{"operation_id":"OP1","kind":"period_comparison","metric_column":"sales","time_column":"date","aggregation":"sum","time_grain":"month","rationale":"Quantify latest change"}]},
      "assertions": [{"type":"equals","path":"results.0.rows.1.period","expected":"2026-03"},{"type":"equals","path":"results.0.rows.1.absolute_change","expected":25},{"type":"approx","path":"results.0.rows.1.percent_change","expected":20,"tolerance":0.000001}]
    },
    {
      "id": "CALC-005", "name": "Zero comparison baseline never produces infinite growth", "category": "calculation", "severity": "critical",
      "rows": [{"date":"2026-01-01","sales":0},{"date":"2026-02-01","sales":10}],
      "plan": {"objective":"Compare monthly sales safely","question_coverage":["Period change"],"operations":[{"operation_id":"OP1","kind":"period_comparison","metric_column":"sales","time_column":"date","aggregation":"sum","time_grain":"month","rationale":"Avoid invalid division"}]},
      "assertions": [{"type":"is_null","path":"results.0.rows.1.percent_change"},{"type":"equals","path":"results.0.rows.1.absolute_change","expected":10}]
    },
    {
      "id": "DATA-001", "name": "Invalid dates block time analysis rather than being silently excluded", "category": "data_quality", "severity": "critical",
      "rows": [{"date":"2026-01-01","sales":10},{"date":"not-a-date","sales":20},{"date":"2026-02-01","sales":30}],
      "plan": {"objective":"Measure monthly sales movement","question_coverage":["Monthly trend"],"operations":[{"operation_id":"OP1","kind":"trend","metric_column":"sales","time_column":"date","aggregation":"sum","rationale":"Inspect change"}]},
      "expected_error": "INVALID_DATE_COLUMN", "assertions": []
    },
    {
      "id": "DATA-002", "name": "Null numeric values do not enter distribution statistics", "category": "data_quality", "severity": "high",
      "rows": [{"score":1},{"score":null},{"score":3},{"score":5}],
      "plan": {"objective":"Describe valid scores","question_coverage":["Distribution"],"operations":[{"operation_id":"OP1","kind":"distribution","metric_column":"score","rationale":"Profile valid observations"}]},
      "assertions": [{"type":"equals","path":"results.0.diagnostics.valid_count","expected":3},{"type":"equals","path":"results.0.diagnostics.missing_count","expected":1},{"type":"equals","path":"results.0.rows.3.value","expected":3}]
    },
    {
      "id": "DATA-003", "name": "Limited rankings disclose omitted categories", "category": "data_quality", "severity": "medium",
