      "expected_error":"zero denominator","assertions":[]
    },
    {
      "id":"ADV-003","name":"Statistical comparison requires explicit groups","category":"methodology","severity":"critical",
      "rows":[{"group":"A","score":1},{"group":"A","score":2},{"group":"A","score":3},{"group":"B","score":4},{"group":"B","score":5},{"group":"B","score":6}],
      "plan":{"objective":"Compare groups","question_coverage":["Difference"],"operations":[{"operation_id":"OP1","kind":"statistical_comparison","metric_column":"score","dimension_column":"group","rationale":"Avoid arbitrary comparison"}]},
      "expected_error":"explicit baseline_value and comparison_value","assertions":[]
    },
    {
      "id":"ADV-004","name":"Statistical comparison quantifies magnitude and uncertainty","category":"uncertainty","severity":"critical",
      "rows":[{"group":"A","score":9},{"group":"A","score":10},{"group":"A","score":11},{"group":"B","score":19},{"group":"B","score":20},{"group":"B","score":21}],
      "plan":{"objective":"Compare group B with group A","question_coverage":["Difference"],"operations":[{"operation_id":"OP1","kind":"statistical_comparison","metric_column":"score","dimension_column":"group","baseline_value":"A","comparison_value":"B","rationale":"Measure effect"}]},
      "assertions":[{"type":"equals","path":"results.0.rows.0.mean_difference","expected":10.0},{"type":"between","path":"results.0.rows.0.permutation_p_value","minimum":0,"maximum":0.1},{"type":"contains","path":"results.0.caveats","expected":"does not establish causal"}]
    },
    {
      "id":"ADV-005","name":"Segment driver contributions reconcile to total movement","category":"calculation","severity":"critical",
      "rows":[{"date":"2026-01-01","segment":"A","sales":100},{"date":"2026-01-01","segment":"B","sales":100},{"date":"2026-02-01","segment":"A","sales":150},{"date":"2026-02-01","segment":"B","sales":80}],
      "plan":{"objective":"Explain sales movement by segment","question_coverage":["Drivers"],"operations":[{"operation_id":"OP1","kind":"segment_change","metric_column":"sales","dimension_column":"segment","time_column":"date","aggregation":"sum","time_grain":"month","rationale":"Reconcile drivers"}]},
      "assertions":[{"type":"equals","path":"results.0.diagnostics.total_change","expected":30.0},{"type":"equals","path":"results.0.diagnostics.reconciliation_residual","expected":0.0},{"type":"equals","path":"results.0.rows.0.segment","expected":"A"}]
