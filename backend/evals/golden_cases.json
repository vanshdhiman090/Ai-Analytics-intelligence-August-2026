      "plan": {"objective":"Identify unusual values","question_coverage":["Outliers"],"operations":[{"operation_id":"OP1","kind":"outlier_analysis","metric_column":"value","rationale":"Flag unusual observations"}]},
      "assertions": [{"type":"equals","path":"results.0.diagnostics.outlier_count","expected":1},{"type":"equals","path":"results.0.rows.1.outlier_value","expected":100},{"type":"contains","path":"results.0.caveats","expected":"must not be removed automatically"}]
