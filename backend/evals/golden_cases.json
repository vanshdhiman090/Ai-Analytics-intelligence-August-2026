    {
      "id": "SAFE-002", "name": "Text metrics cannot be silently aggregated as numeric", "category": "safety", "severity": "critical",
      "rows": [{"region":"North","revenue":"high"},{"region":"South","revenue":"low"}],
      "plan": {"objective":"Average revenue by region","question_coverage":["Revenue"],"operations":[{"operation_id":"OP1","kind":"grouped_aggregate","metric_column":"revenue","dimension_column":"region","aggregation":"mean","rationale":"Compare revenue"}]},
      "expected_error": "requires numeric column", "assertions": []
    },
    {
      "id": "SAFE-003", "name": "Duplicate operation IDs are rejected", "category": "safety", "severity": "high",
      "rows": [{"sales":10},{"sales":20}],
      "plan": {"objective":"Describe sales safely","question_coverage":["Summary and distribution"],"operations":[{"operation_id":"OP1","kind":"distribution","metric_column":"sales","rationale":"Spread"},{"operation_id":"OP1","kind":"summary","rationale":"Summary"}]},
      "expected_error": "IDs must be unique", "assertions": []
    },
    {
      "id": "UNCERT-001", "name": "Small correlation samples are explicitly exploratory", "category": "uncertainty", "severity": "critical",
      "rows": [{"x":1,"y":2},{"x":2,"y":4},{"x":3,"y":5}],
      "plan": {"objective":"Explore association","question_coverage":["Association"],"operations":[{"operation_id":"OP1","kind":"correlation","metric_column":"x","dimension_column":"y","rationale":"Measure association"}]},
      "assertions": [{"type":"equals","path":"results.0.quality_status","expected":"caution"},{"type":"contains","path":"results.0.caveats","expected":"exploratory"},{"type":"equals","path":"results.0.rows.0.pair_count","expected":3}]
    },
    {
      "id": "UNCERT-002", "name": "Constant columns cannot produce fake correlation", "category": "uncertainty", "severity": "critical",
      "rows": [{"x":1,"y":1},{"x":1,"y":2},{"x":1,"y":3}],
      "plan": {"objective":"Assess association","question_coverage":["Association"],"operations":[{"operation_id":"OP1","kind":"correlation","metric_column":"x","dimension_column":"y","rationale":"Measure association"}]},
      "expected_error": "requires variation", "assertions": []
    },
