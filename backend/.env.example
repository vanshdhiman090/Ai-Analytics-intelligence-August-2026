# Copy this file to .env and fill in real values. Never commit .env itself.

DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_key_here
# gemini-2.0-flash-lite is the real free-tier model name
GEMINI_MODEL=gemini-2.0-flash-lite
CHECKPOINT_BACKEND=postgres
CHECKPOINT_POOL_SIZE=4
RUN_WORKERS=2
DB_POOL_SIZE=5
DATA_DIR=./data
MAX_UPLOAD_BYTES=26214400
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3010,http://127.0.0.1:3010

# API key auth — leave empty to disable (local dev). Set one or more keys to protect all endpoints.
# Multiple keys can be comma-separated: API_KEYS=key1,key2
API_KEYS=

# Files older than this (days) from complete/error sessions will be auto-deleted.
FILE_TTL_DAYS=7

# Stable namespace for lessons reused across runs. Use a unique value per tenant/workspace.
MEMORY_SCOPE=local-workspace

# Optional read-only Google Intelligence Connector Pack credentials. For durable
# local access, provide the refresh token and matching OAuth client credentials;
# the app renews the short-lived access token in memory and never writes it to disk.
# Never commit real credentials.
GOOGLE_ACCESS_TOKEN=
GOOGLE_REFRESH_TOKEN=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_CONNECTOR_TIMEOUT_SECONDS=20

# Optional overrides for native editable PowerPoint generation. The local Codex
# runtime is discovered automatically when these are omitted.
# PRESENTATION_NODE_BINARY=C:\path\to\node.exe
# ARTIFACT_TOOL_ENTRY=C:\path\to\artifact_tool.mjs
