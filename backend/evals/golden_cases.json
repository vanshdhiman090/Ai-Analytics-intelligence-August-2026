      "question": "Are there unusual outliers in revenue?", "rows": [{"revenue":10},{"revenue":11},{"revenue":100}],
      "plan": {"objective":"Summarize revenue","question_coverage":["Revenue"],"operations":[{"operation_id":"OP1","kind":"grouped_aggregate","metric_column":"revenue","dimension_column":null,"aggregation":"sum","rationale":"Total revenue"}]},
      "expected_error": "no distribution diagnostic", "assertions": []
    },
    {
      "id": "METHOD-003", "name": "Auto time grain selects daily periods for short spans", "category": "methodology", "severity": "medium",
      "rows": [{"date":"2026-01-01","sales":10},{"date":"2026-01-03","sales":20}],
      "plan": {"objective":"Inspect short-term sales","question_coverage":["Daily movement"],"operations":[{"operation_id":"OP1","kind":"trend","metric_column":"sales","time_column":"date","aggregation":"sum","time_grain":"auto","rationale":"Choose suitable grain"}]},
      "assertions": [{"type":"equals","path":"results.0.diagnostics.time_grain","expected":"day"},{"type":"equals","path":"results.0.rows.1.period","expected":"2026-01-03"}]
