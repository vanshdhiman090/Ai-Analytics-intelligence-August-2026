      "assertions": [{"type":"equals","path":"results.0.quality_status","expected":"ready"},{"type":"not_null","path":"results.0.diagnostics.mean_ci_95_low"},{"type":"not_null","path":"results.0.diagnostics.mean_ci_95_high"}]
